# Example process variables; .env is not loaded automatically.
EMOBOT_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMOBOT_API_KEY=
EMOBOT_FAST_MODEL=qwen3.6-flash
EMOBOT_REASONING_MODEL=deepseek-v4-flash
EMOBOT_LANGUAGE=zh
EMOBOT_MEMORY_ENABLED=true
EMOBOT_SAVE_HISTORY=true
EMOBOT_EMBEDDING_URL=
EMOBOT_EMBEDDING_KEY=
EMOBOT_EMBEDDING_MODEL=
EMOBOT_EMBEDDING_DIMENSIONS=1024
# Leave blank for local SQLite; optional PostgreSQL requires its extra dependencies.
EMOBOT_DATABASE_URL=
